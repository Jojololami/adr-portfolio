+          {num} · {c.eyebrow}
+        </p>
+        <h2 className="mb-3 font-display text-2xl font-bold md:text-3xl">{c.title}</h2>
+        <p className="text-muted-foreground">
+          <Fill value={c.context} />
+        </p>
+      </article>
+    );
+  }
+
+  return (
